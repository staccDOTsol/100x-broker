        { "name": "market", "docs": ["hooked Market"] },
        { "name": "clmm_pool", "docs": ["the market's oracle pool (Raydium CLMM)"] },
        { "name": "x_mint" },
        { "name": "down_mint", "docs": ["the market's bear mint"] },
        { "name": "vault_wsol_ata", "docs": ["ATA(WSOL, sol_pda)"] },
        { "name": "vault_x_ata", "docs": ["ATA(x_mint, sol_pda) under the mint's token program"] },
        { "name": "vault_quote_ata", "docs": ["ATA(r-fstacc, vault)"] },
        { "name": "vault_down_ata", "docs": ["ATA(down_mint, vault) under Token-2022"] },
        { "name": "system_program", "address": "11111111111111111111111111111111" },
        { "name": "token_program", "address": "TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA" }
      ],
      "args": [
        { "name": "tick_lower", "type": "i32" },
        { "name": "tick_upper", "type": "i32" },
