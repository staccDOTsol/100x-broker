{
  "address": "63rmnKrW69fhp8bYKT21GE4kUVouMvdr1EwxHfKbvKFU",
  "metadata": {
    "name": "dnvault",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Delta-neutral LP vaults on 100x.broker: LP a coin against SOL on its Raydium CLMM, hedge the coin leg with -100x DOWN sized to exposure/100, keep the fees. Receipt shares are SPL tokens priced at NAV. Keeper proposes allowlisted CPIs; the program verifies no value leak and the hedge got no worse, then pays the keeper. Written in Pinocchio; instruction discriminators are one byte.",
    "repository": "https://100x.broker"
  },
  "instructions": [
    {
      "name": "create_vault",
      "docs": ["Permissionless. One vault per (market, tick range). Token accounts are plain ATAs: WSOL and X under the SOL sub-account, quote and DOWN under the vault."],
      "discriminator": [0],
      "accounts": [
        { "name": "creator", "writable": true, "signer": true },
        { "name": "vault", "writable": true, "pda": { "seeds": [{ "kind": "const", "value": [118, 97, 117, 108, 116] }, { "kind": "account", "path": "market" }, { "kind": "arg", "path": "tick_lower" }, { "kind": "arg", "path": "tick_upper" }] } },
        { "name": "share_mint", "writable": true, "pda": { "seeds": [{ "kind": "const", "value": [115, 104, 97, 114, 101, 115] }, { "kind": "account", "path": "vault" }] } },
