{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/og.ts": {
      "includeFiles": "api/_fonts/**",
      "maxDuration": 30,
      "memory": 1024
    },
    "api/page.ts": {
      "includeFiles": "api/_fonts/**",
      "maxDuration": 15
    },
    "api/feed.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/leaders.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/dnfeed.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/ref.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/arena.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/markets.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/swap.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/winners.ts": {
      "includeFiles": "api/_data/**",
      "maxDuration": 60,
      "memory": 1024
    },
    "api/launch.ts": {
      "maxDuration": 30
    },
    "api/war.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/legs.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/warbot.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/ngu-history.ts": {
      "maxDuration": 60
    },
    "api/dflow.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/c/:mint",
      "destination": "https://wjvksitfxf9annmd.public.blob.vercel-storage.com/coins/:mint/meta.json"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/m/:key",
      "destination": "/api/page?key=:key"
    },
    {
      "source": "/a",
      "destination": "/api/page?war=action"
    },
    {
      "source": "/w/:id",
      "destination": "/api/page?war=:id"
    },
    {
      "source": "/p/:wallet",
      "destination": "/api/page?owner=:wallet"
    },
    {
      "source": "/yield/:vault",
      "destination": "/api/page?vault=:vault"
    },
    {
      "source": "/meta",
      "destination": "/api/page?meta=1"
    },
    {
      "source": "/ngu",
      "destination": "/api/page?ngu=1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.lastbidwins.fun"
        }
      ],
      "destination": "/play",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "lastbidwins.fun"
        }
      ],
      "destination": "/play",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/warbot",
      "schedule": "* * * * *"
    }
  ]
}
